            minimumHeight = dp(124)
            background = GradientDrawable(
                GradientDrawable.Orientation.LEFT_RIGHT,
                intArrayOf(GREEN, GREEN_DARK)
            ).apply {
                cornerRadii = floatArrayOf(
                    0f, 0f, 0f, 0f,
                    dp(26f).toFloat(), dp(26f).toFloat(),
                    dp(26f).toFloat(), dp(26f).toFloat()
                )
            }
        }

        val mark = FrameLayout(this).apply {
            background = circle(Color.argb(38, 255, 255, 255))
        }
        mark.addView(iconView(R.drawable.ic_explore, Color.WHITE, 40), FrameLayout.LayoutParams(dp(44), dp(44), Gravity.CENTER))
        frame.addView(mark, FrameLayout.LayoutParams(dp(62), dp(62), Gravity.RIGHT or Gravity.CENTER_VERTICAL).apply {
            rightMargin = dp(16)
        })

        val titles = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.RIGHT or Gravity.CENTER_VERTICAL
            setPadding(dp(12), dp(12), dp(12), dp(12))
        }
        titles.addView(text("راصد البرية", 27f, Color.WHITE, true).apply { gravity = Gravity.RIGHT })
        titles.addView(text("سجل ميداني بصري لاكتشافاتك ورحلاتك", 14.2f, Color.rgb(230, 239, 234), false).apply {
            gravity = Gravity.RIGHT
            setPadding(0, dp(3), 0, 0)
        })
        titles.addView(text("رصد • موقع • توثيق", 11.5f, Color.rgb(207, 224, 214), true).apply {
            gravity = Gravity.RIGHT
            setPadding(0, dp(7), 0, 0)
        })
        frame.addView(titles, FrameLayout.LayoutParams(-1, -1).apply {
            rightMargin = dp(88)
            leftMargin = dp(68)
        })

        val settings = iconButton(R.drawable.ic_settings, Color.WHITE, 40).apply {
            contentDescription = "الإعدادات"
            background = circle(Color.argb(32, 255, 255, 255))
            setOnClickListener { showSettings() }
        }
        frame.addView(settings, FrameLayout.LayoutParams(dp(46), dp(46), Gravity.LEFT or Gravity.TOP).apply {
            leftMargin = dp(14)
